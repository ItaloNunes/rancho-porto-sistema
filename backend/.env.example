# URL e chaves do seu projeto Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=coloque-a-service-role-key-aqui
SUPABASE_ANON_KEY=coloque-a-anon-key-aqui

# E-mail interno que recebe cópia dos pedidos de reserva (opcional).
NOTIFICACAO_EMAIL=

# Origem(ns) permitida(s) para o frontend chamar a API, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173
