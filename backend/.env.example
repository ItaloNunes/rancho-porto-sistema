# URL e chaves do seu projeto Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=coloque-a-service-role-key-aqui
SUPABASE_ANON_KEY=coloque-a-anon-key-aqui

# E-mail interno que recebe cópia dos pedidos de reserva (opcional).
NOTIFICACAO_EMAIL=

# Origem(ns) permitida(s) para o frontend chamar a API, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173

# URL pública do frontend (não é mais usada por nenhum e-mail; login do
# painel não depende disso).
FRONTEND_URL=http://localhost:5173

# Documentação interativa da API (/docs, /redoc, /openapi.json). Desligada por
# padrão. Ligue como "true" só no seu .env local pra debugar a API; NUNCA
# defina essa variável no Render (produção deve continuar sem docs públicas).
ENABLE_DOCS=false

# Segredo que assina o login do painel (JWT) — login próprio, sem Supabase
# Auth (ver app/security.py). OBRIGATÓRIO definir em produção com um valor
# longo e aleatório, por exemplo gerado com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Se ficar no valor padrão do código, qualquer um que leia o repositório
# consegue forjar um login admin — nunca suba isso sem trocar.
JWT_SECRET=troque-este-segredo-em-producao
